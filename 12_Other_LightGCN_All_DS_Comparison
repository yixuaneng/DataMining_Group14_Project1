    "        \"novel_recall@10\", \"repeated_positive_pairs\", \"novel_positive_pairs\"]\n",
    "ALL5[cols].to_csv(OUT / \"baselines_all5_repeat_novel.csv\", index=False)\n",
    "ALL5[[\"dataset\", \"n_items\", \"method\", \"NDCG@10\", \"repeated_recall@10\", \"novel_recall@10\"]].round(4)"
