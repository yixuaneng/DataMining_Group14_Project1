    "             \"eligible_train_seen_customer_mask\"]\n",
    "\n",
    "\n",
    "def save_snapshot(snapshot, path):\n",
    "    np.savez_compressed(path, **{k: snapshot[k] for k in SAVE_KEYS})\n",
    "\n",
    "\n",
    "def sha256_file(p):\n",
    "    h = hashlib.sha256()\n",
    "    with open(p, \"rb\") as f:\n",
    "        for chunk in iter(lambda: f.read(1 << 20), b\"\"):\n",
    "            h.update(chunk)\n",
    "    return h.hexdigest()\n"
   ]
